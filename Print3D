<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Robótica y piezas 3D · Proyectos</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&display=swap" rel="stylesheet">
<style>
:root{--paper:#e8edf0;--ink:#13222b;--mute:#52656f;--line:#b9c6cd;--accent:#2a4bff;--sel:#dbe3ff;
 box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--paper:#0e1a21;--ink:#e6eef2;--mute:#8ea1ab;--line:#26404d;--accent:#7fa0ff;--sel:#1a2b4d}}
:root[data-theme="dark"]{--paper:#0e1a21;--ink:#e6eef2;--mute:#8ea1ab;--line:#26404d;--accent:#7fa0ff;--sel:#1a2b4d}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:"Bricolage Grotesque",system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.55;
 background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:48px 48px;background-attachment:fixed}
body::before{content:"";position:fixed;inset:0;background:var(--paper);opacity:.82;pointer-events:none;z-index:-1}
.wrap{display:grid;grid-template-columns:1fr;gap:0;max-width:1180px;margin:0 auto;padding:0 20px}
.stage{position:sticky;top:0;height:46vh;z-index:2;background:var(--paper);border-bottom:1px solid var(--line)}
#c{width:100%;height:100%;display:block;cursor:grab;touch-action:pan-y}
#c:active{cursor:grabbing}
.tag{position:absolute;left:0;bottom:10px;font-size:.85rem;color:var(--mute)}
main{padding:28px 0 20px}
h1{font-size:clamp(2.4rem,7vw,4.6rem);line-height:1;letter-spacing:-.03em;font-weight:800;margin:0 0 18px}
.lead{max-width:46ch;color:var(--mute);font-size:1.1rem;margin:0 0 36px}
h2{font-size:1.3rem;margin:0 0 6px;font-weight:600}
.hint{color:var(--mute);margin:0 0 14px;font-size:.95rem}
ul{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
li button{all:unset;box-sizing:border-box;display:grid;grid-template-columns:1fr auto;gap:2px 16px;width:100%;padding:18px 10px;border-bottom:1px solid var(--line);cursor:pointer}
li button:hover{background:var(--sel)}
li button[aria-pressed="true"]{background:var(--sel);box-shadow:inset 4px 0 0 var(--accent)}
li button:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
.n{font-weight:600;font-size:1.2rem}
.m{color:var(--mute);font-size:.9rem;text-align:right}
.d{grid-column:1/-1;color:var(--mute);max-width:56ch}
.about{margin:48px 0 0;padding:24px 0;border-top:1px solid var(--line);max-width:56ch}
.about a{color:var(--accent);font-weight:600}
footer{padding:28px 0 36px;color:var(--mute);font-size:.85rem}
@media (min-width:860px){
 .wrap{grid-template-columns:1fr 1fr;gap:56px}
 .stage{grid-column:2;grid-row:1;height:100vh;height:100dvh;border:0;background:transparent}
 main{grid-column:1;grid-row:1;padding:64px 0 20px}
 footer{grid-column:1}
}
@media (prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
</head>
<body>
<div class="wrap">
 <main>
  <h1>Robótica y piezas 3D para el día a día</h1>
  <p class="lead">Piezas para robots y objetos útiles para casa, diseñados para imprimir en 3D. Elige un proyecto y míralo girar a la derecha: arrástralo para verlo desde otro ángulo.</p>
  <h2>Proyectos</h2>
  <p class="hint">Toca uno para cargarlo en el visor.</p>
  <ul id="list"></ul>
  <section class="about">
    <h2>Trabajemos juntos</h2>
    <p>Cuéntame qué pieza o mecanismo necesitas y te respondo con una propuesta.</p>
    <p><a href="mailto:david@torredelahoradada.es">david@torredelahoradada.es</a></p>
  </section>
 </main>
 <div class="stage" aria-label="Visor 3D del proyecto seleccionado">
  <canvas id="c"></canvas>
  <div class="tag" id="tag"></div>
 </div>
 <footer>© 2026 Torre de la Horadada</footer>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
const P=[
 {n:"Pinza para brazo robótico",m:"Fusion 360 · 2026",d:"Garra de tres dedos para brazos de servomotores, imprimible sin soportes.",g:()=>new THREE.TorusGeometry(1.1,.4,8,5)},
 {n:"Engranaje de transmisión",m:"Fusion 360 · 2026",d:"Piezas dentadas para reductoras de robots pequeños.",g:()=>new THREE.CylinderGeometry(1.4,1.4,.6,12,1)},
 {n:"Rueda para robot rastreador",m:"Blender · 2025",d:"Rueda con banda de goma y cubo para motor de 3 mm.",g:()=>new THREE.TorusGeometry(1.2,.5,10,22)},
 {n:"Carcasa para sensores",m:"Fusion 360 · 2025",d:"Caja con ventanas para sensores de distancia y placa de control.",g:()=>new THREE.BoxGeometry(2.2,1.5,1.5,4,3,3)},
 {n:"Organizador hexagonal",m:"Blender · 2025",d:"Portalápices y herramientas para el escritorio que encajan en panal.",g:()=>new THREE.CylinderGeometry(1,1,1.8,6,5)},
 {n:"Clip para cables",m:"Fusion 360 · 2024",d:"Pieza sencilla para ordenar cables en mesas y paredes.",g:()=>new THREE.TorusGeometry(1.1,.28,8,28,Math.PI*1.5)}
];

const css=n=>getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const cv=document.getElementById('c');
const R=new THREE.WebGLRenderer({canvas:cv,antialias:true,alpha:true});
R.setPixelRatio(Math.min(devicePixelRatio,2));
const S=new THREE.Scene(),C=new THREE.PerspectiveCamera(40,1,.1,50);C.position.z=5.2;
const mat=new THREE.MeshBasicMaterial({wireframe:true,color:0x2a4bff});
const mesh=new THREE.Mesh(P[0].g(),mat);S.add(mesh);
function colour(){mat.color.set(css('--accent'))}
matchMedia('(prefers-color-scheme:dark)').addEventListener('change',colour);
function size(){const w=cv.clientWidth,h=cv.clientHeight;R.setSize(w,h,false);C.aspect=w/h;C.updateProjectionMatrix()}
addEventListener('resize',size);
let drag=false,lx=0,ly=0,vx=.004,vy=.006;
cv.addEventListener('pointerdown',e=>{drag=true;lx=e.clientX;ly=e.clientY;cv.setPointerCapture(e.pointerId)});
cv.addEventListener('pointerup',()=>drag=false);
cv.addEventListener('pointermove',e=>{if(!drag)return;mesh.rotation.y+=(e.clientX-lx)*.01;mesh.rotation.x+=(e.clientY-ly)*.01;lx=e.clientX;ly=e.clientY});
const calm=matchMedia('(prefers-reduced-motion:reduce)').matches;
function loop(){if(!drag&&!calm){mesh.rotation.x+=vx;mesh.rotation.y+=vy}R.render(S,C);requestAnimationFrame(loop)}
function pick(i){
 mesh.geometry.dispose();mesh.geometry=P[i].g();
 document.getElementById('tag').textContent=P[i].n+" · "+P[i].m;
 document.querySelectorAll('#list button').forEach((b,j)=>b.setAttribute('aria-pressed',j===i));
}
const ul=document.getElementById('list');
P.forEach((p,i)=>{
 const li=document.createElement('li');
 li.innerHTML='<button type="button" aria-pressed="false"><span class="n"></span><span class="m"></span><span class="d"></span></button>';
 li.querySelector('.n').textContent=p.n;li.querySelector('.m').textContent=p.m;li.querySelector('.d').textContent=p.d;
 li.firstChild.addEventListener('click',()=>pick(i));ul.appendChild(li);
});
colour();size();pick(0);loop();
</script>
</body>
</html>
